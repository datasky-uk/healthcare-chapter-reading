# Copy to .env and fill in from Supabase: Project Settings > API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Secret: never commit or share. Used only by the local scripts.
SUPABASE_SERVICE_KEY=
# The deployed tracker address, used in invitation emails
SITE_URL=https://YOUR-GITHUB-NAME.github.io/chapter-reading-tracker/
# Shown on the sign-in page to people who aren't invited yet
CONTACT_NAME=the chapter lead
